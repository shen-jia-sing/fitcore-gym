# EC2-1 (gateway node). Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (without a database name; each service picks its own database)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Same value on all three EC2 instances. Generate with: openssl rand -hex 24
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Signs and verifies login tokens (at least 32 characters). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# First admin account, created automatically on first start
SEED_ADMIN_NAME=FitCore Admin
SEED_ADMIN_EMAIL=admin@fitcore.com
SEED_ADMIN_PASSWORD=Admin@12345

# Private IPv4 addresses of the service nodes (EC2 console -> instance -> Private IPv4 address)
NODE_A_HOST=172.31.0.0
NODE_B_HOST=172.31.0.0
