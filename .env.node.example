# EC2-2 and EC2-3 (service nodes). Copy to .env and fill in real values. Never commit .env.

# node-a on EC2-2, node-b on EC2-3
NODE_NAME=node-a

# Same MongoDB Atlas connection string as EC2-1
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Same value as on EC2-1
INTERNAL_API_KEY=change-me-to-a-long-random-string
